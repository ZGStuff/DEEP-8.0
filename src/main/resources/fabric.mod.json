{
  "schemaVersion": 1,
  "id": "deep",
  "version": "${version}",

  "name": "DEEP",
  "description": "A mod that adds new materials, decorative blocks, recipes, and more to BTA. Now on 8.0!",
  "authors": [
    "Silveecakes, Erisatis Alterna"
  ],
  "contact": {
    "homepage": "",
    "sources": ""
  },

	"icon": "icon.png",
  "license": "MIT",

  "environment": "*",
  "entrypoints": {
    "main": [
			"silveon22.deep.Deep"
    ],
		"beforeGameStart": [
			"silveon22.deep.Deep"
		],
		"afterGameStart": [
			"silveon22.deep.Deep"
		],
		"afterItemInit": [
			"silveon22.deep.item.DEEPItems"
		],
		"initModels": [
			"silveon22.deep.DEEPModels"
		],
		"recipesReady": [
			"silveon22.deep.DEEPRecipes"
		]
	},
  "mixins": [
      "deep.mixins.json"
  ],

  "depends": {
		"minecraft": "*",
    "fabricloader": ">=0.15.5"
  },
  "suggests": {
  }
}
